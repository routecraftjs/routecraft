[
  {
    "pattern": "context:*",
    "events": [
      "starting",
      "started",
      "stopping",
      "stopped",
      "error"
    ],
    "anchor": "context-events"
  },
  {
    "pattern": "route:*",
    "events": [
      "registered",
      "starting",
      "started",
      "stopping",
      "stopped",
      "source:failed",
      "error",
      "error:caught"
    ],
    "anchor": "route-events"
  },
  {
    "pattern": "route:{routeId}:exchange:*",
    "events": [
      "started",
      "completed",
      "failed",
      "dropped",
      "restored",
      "suspended",
      "resumed",
      "expired"
    ],
    "anchor": "exchange-events"
  },
  {
    "pattern": "route:{routeId}:op:*",
    "events": [
      "adapter",
      "batch",
      "split",
      "aggregate",
      "retry",
      "choice",
      "error",
      "agent",
      "source:parse"
    ],
    "anchor": "operation-events",
    "note": "Each operation emits its own started / completed / failed."
  },
  {
    "pattern": "plugin:{pluginId}:*",
    "events": [
      "applying",
      "applied",
      "starting",
      "started",
      "stopping",
      "stopped"
    ],
    "anchor": "plugin-events",
    "note": "applying / applied bracket apply(); starting / started bracket the optional start() hook, so a plugin without one emits the applying pair only."
  },
  {
    "pattern": "auth:*",
    "events": [
      "success",
      "rejected"
    ],
    "anchor": "authentication-events"
  },
  {
    "pattern": "server:*",
    "events": [
      "listening",
      "failed",
      "closed"
    ],
    "anchor": "server-events",
    "note": "Emitted by the named-servers listener. Every mount on a shared socket (http, mcp, ops) reports its listener lifecycle here rather than on its own plugin."
  },
  {
    "pattern": "agent:*",
    "events": [
      "registered",
      "tool:registered"
    ],
    "anchor": "agent-registration-events"
  },
  {
    "pattern": "plugin:http:*",
    "events": [
      "request:completed"
    ],
    "anchor": "http-plugin-events"
  },
  {
    "pattern": "plugin:ops:*",
    "events": [
      "health:changed"
    ],
    "anchor": "ops-plugin-events"
  },
  {
    "pattern": "plugin:mcp:*",
    "events": [
      "server:tools:exposed",
      "tool:called",
      "tool:completed",
      "tool:suspended",
      "tool:failed",
      "tool:declined"
    ],
    "anchor": "mcp-plugin-events"
  }
]
