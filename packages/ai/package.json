{
  "name": "@routecraft/ai",
  "version": "0.7.0",
  "description": "AI and MCP integrations for Routecraft",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ai": "^6.0.246"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.107",
    "@ai-sdk/google": "^3.0.104",
    "@ai-sdk/openai": "^3.0.91",
    "@ai-sdk/openai-compatible": "^1.0.47",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@routecraft/routecraft": "workspace:*",
    "@routecraft/testing": "workspace:*",
    "@sinonjs/fake-timers": "^11.3.1",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "jose": "^6.2.8",
    "ollama-ai-provider-v2": "^3.6.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/google": "^3.0.34",
    "@ai-sdk/openai": "^3.0.37",
    "@ai-sdk/openai-compatible": "^1.0.46",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@routecraft/routecraft": ">=0.7.0 <1.0.0",
    "ollama-ai-provider-v2": "^3.3.1",
    "yaml": "^2.8.0"
  },
  "keywords": [
    "routecraft",
    "ai",
    "mcp",
    "tools",
    "llm"
  ],
  "author": "routecraftjs",
  "license": "Apache-2.0",
  "homepage": "https://routecraft.dev",
  "bugs": "https://github.com/routecraftjs/routecraft/issues",
  "repository": "https://github.com/routecraftjs/routecraft",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/node": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  }
}
