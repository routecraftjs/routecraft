{
  "name": "@routecraft/os",
  "version": "0.6.0",
  "description": "System-native host adapters for Routecraft: isolated shell execution and browser automation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@routecraft/routecraft": "workspace:*",
    "@routecraft/testing": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "agent-browser": "^0.34.0",
    "dockerode": "^5.0.1",
    "execa": "^9.6.0",
    "shescape": "^3.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@routecraft/routecraft": ">=0.7.0-0 <1.0.0",
    "agent-browser": "^0.34.0",
    "dockerode": "^5.0.1",
    "execa": "^9.6.0",
    "shescape": "^3.0.2"
  },
  "peerDependenciesMeta": {
    "agent-browser": {
      "optional": true
    },
    "dockerode": {
      "optional": true
    },
    "execa": {
      "optional": true
    },
    "shescape": {
      "optional": true
    }
  },
  "keywords": [
    "routecraft",
    "os",
    "shell",
    "browser",
    "automation",
    "agent-browser",
    "playwright"
  ],
  "author": "routecraftjs",
  "license": "Apache-2.0",
  "homepage": "https://routecraft.dev",
  "bugs": "https://github.com/routecraftjs/routecraft/issues",
  "repository": "https://github.com/routecraftjs/routecraft",
  "publishConfig": {
    "access": "public"
  }
}
